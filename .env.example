# This is an example .env file.
# Duplicate this file as .env and fill in your actual credentials.

# OpenAI Configuration
OPENAI_API_KEY="sk-your_openai_api_key"
# Optional: Specify a default model for OpenAI
# OPENAI_MODEL_NAME="gpt-3.5-turbo"

# Anthropic Configuration
ANTHROPIC_API_KEY="sk-ant-your_anthropic_api_key"
# Optional: Specify a default model for Anthropic
# ANTHROPIC_MODEL_NAME="claude-2"

# Cohere Configuration
COHERE_API_KEY="your_cohere_api_key"
# Optional: Specify a default model for Cohere
# COHERE_MODEL_NAME="command"

# Hugging Face Configuration
# HUGGINGFACE_API_KEY="hf_your_huggingface_api_key" # For accessing private/gated models
# Optional: Specify a default model for Hugging Face
# HUGGINGFACE_MODEL_NAME="meta-llama/Llama-2-7b-chat-hf"

# Bedrock Configuration
# These are typically set in your AWS environment (e.g., ~/.aws/credentials or IAM roles)
# but can be overridden here if needed.
# BEDROCK_AWS_ACCESS_KEY_ID="your_aws_access_key_id"
# BEDROCK_AWS_SECRET_ACCESS_KEY="your_aws_secret_access_key"
# BEDROCK_AWS_REGION_NAME="us-east-1"
# Optional: Specify a default model for Bedrock
# BEDROCK_MODEL_NAME="anthropic.claude-v2" # Example, replace with your desired Bedrock model

# Vertex AI Configuration
# Ensure you have authenticated with Google Cloud CLI: `gcloud auth application-default login`
# VERTEX_AI_PROJECT="your-gcp-project-id"
# VERTEX_AI_LOCATION="us-central1" # e.g., us-central1
# Optional: Specify a default model for Vertex AI
# VERTEX_AI_MODEL_NAME="gemini-pro"

# Azure OpenAI Configuration
# AZURE_API_KEY="your_azure_openai_api_key"
# AZURE_API_BASE="your_azure_openai_endpoint" # e.g., https://your-resource-name.openai.azure.com/
# AZURE_API_VERSION="2023-07-01-preview" # Or your desired API version
# Optional: Specify a default model for Azure OpenAI (this is often the deployment ID)
# AZURE_MODEL_NAME="your-deployment-name"

# Add other provider configurations as needed following a similar pattern:
# PROVIDERNAME_API_KEY="your_key"
# PROVIDERNAME_MODEL_NAME="default_model_for_provider"

# LiteLLM general settings
# LITELLM_LOG_LEVEL="DEBUG" # Optional: Set to DEBUG for verbose logging
# LITELLM_MAX_BUDGET="100" # Optional: Set a maximum budget for your project ($USD)
# LITELLM_TELEMETRY="False" # Optional: Disable telemetry by setting to False

# If you are using specific models that require more params, you can set them as:
# MODEL_PROVIDER_MODEL_NAME_PARAM_NAME="value"
# e.g. for a hypothetical model 'custom/my-model' that needs 'custom_param':
# CUSTOM_MY_MODEL_CUSTOM_PARAM="some_value"
